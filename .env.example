# ==============================================================================
# Recover - Production Test Mode Environment Configuration
# ==============================================================================

# Application Base URL (for webhooks & links)
APP_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# OpenRouter AI Configuration (LangChain + OpenRouter)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_TITLE=Recover

# ------------------------------------------------------------------------------
# Supabase & PostgreSQL Configuration (Domain DB + pgvector + Checkpoints)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Razorpay Test Mode Configuration
# ------------------------------------------------------------------------------
RECOVER_RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ------------------------------------------------------------------------------
# Optional Testing Flags
# ------------------------------------------------------------------------------
RUN_RAZORPAY_INTEGRATION_TESTS=false
